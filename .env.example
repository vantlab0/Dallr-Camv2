# Dallr Cam Environment Variables
VITE_APP_NAME=Dallr Cam
VITE_APP_ENV=development

# -----------------------------------------------------------------------------
# Client-side Supabase configuration (safe to expose in the desktop bundle)
# Vite only exposes variables prefixed with VITE_.
# -----------------------------------------------------------------------------
VITE_SUPABASE_URL=https://your-project-id.supabase.co
# Legacy anon key (JWT) ...
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here
# ... or the new-style publishable key. Either one may be provided.
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_publishable_key

# -----------------------------------------------------------------------------
# Supabase Edge Functions secrets
# Set these with `supabase secrets set --env-file supabase/functions/.env`
# (or in the Supabase Dashboard). NEVER commit real values and NEVER prefix
# these with VITE_.
# -----------------------------------------------------------------------------
SUPABASE_URL=https://your-project-id.supabase.co
# Legacy service_role JWT or new-style secret key (sb_secret_...). Either works.
SUPABASE_SERVICE_ROLE_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-service-role-key
SUPABASE_SECRET_KEY=sb_secret_your_secret_key
SUPABASE_JWKS_URL=https://your-project-id.supabase.co/auth/v1/.well-known/jwks.json

# Paystack (server-side secret only)
PAYSTACK_SECRET_KEY=sk_test_...
PAYSTACK_PUBLIC_KEY=pk_test_...
PAYSTACK_USD_TO_NGN_RATE=1550

# Shared secret for the scheduled reconcile-payments worker
RECONCILE_SHARED_SECRET=generate_a_long_random_secret

# Decart realtime API
DECART_API_KEY=your_decart_api_key
