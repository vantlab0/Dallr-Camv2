# Dallr Cam Environment Variables
VITE_APP_NAME=Dallr Cam
VITE_APP_ENV=development

# Supabase Authentication & API Configuration
# Provide your Supabase project URL and anon/public key (never expose service_role key to client)
VITE_SUPABASE_URL=https://your-project-id.supabase.co
VITE_SUPABASE_ANON_KEY=eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.your-anon-key-here

# Supabase Edge Functions Secrets (Set in Supabase Dashboard / CLI, NOT in client Vite bundle)
# SUPABASE_URL=https://your-project-id.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=ey... (Server side only)
# PAYSTACK_SECRET_KEY=sk_live_... or sk_test_... (Server side only)
# PAYSTACK_USD_TO_NGN_RATE=1550 (Configured server side rate)
